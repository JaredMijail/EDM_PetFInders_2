# ---- Gráficos con plotct (si tienes el paquete cargado) ----
# Asegúrate de tener: library(vcd)  o  library(cotabplot)
par(mfrow = c(2, 1), mai = c(0.4, 1, 0.3, 0.1))
# Perfil fila de t(tc): cada fila suma 100%
plotct(t(tc), "row", col = 2:5,
main = "Perfil fila (t(tc))")
