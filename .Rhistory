vars_activas <- c("AdoptionSpeed_agrupada", "MaturitySize_agrupada","FurLength", "Color1_agrupada", "Color2_agrupada", "Color3_agrupada", "Breed1_agrupada", "Breed2_agrupada")
datos_acm <- datos[, vars_activas]
vars_activas <- c("AdoptionSpeed_agrupada", "MaturitySize_agrupada","FurLength", "Color1_agrupada", "Color2_agrupada", "Color3_agrupada", "Breed1_agrupada", "Breed2_agrupada")
