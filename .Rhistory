renv::install("ggplot2")
renv::snapshot()
tabla <- table(datos$AdoptionSpeed_agrupada, datos$Breed1_agrupada)
resultado <- chisq.test(tabla)
print(resultado)
perfil_fila <- prop.table(tabla, margin = 1) * 100
round(perfil_fila, 2)
perfil_columna <- prop.table(tabla, margin = 2) * 100
round(perfil_columna)
# =========================================================
# 1) PERFIL FILA (cada fila suma 100%)
# =========================================================
df_fila <- as.data.frame(perfil_fila)
names(df_fila) <- c("Fila", "Columna", "Porcentaje")
ggplot(df_fila, aes(x = Fila, y = Porcentaje, fill = Columna)) +
geom_col(position = "dodge") +
geom_text(aes(label = sprintf("%.1f%%", Porcentaje)),
position = position_dodge(width = 0.9),
vjust = -0.3, size = 3) +
labs(title = "Perfil por fila",
subtitle = "Porcentaje dentro de cada fila (suma 100%)",
x = NULL, y = "Porcentaje (%)") +
theme_minimal() +
theme(legend.position = "bottom") +
scale_fill_brewer(palette = "Set2")
# =========================================================
# 2) PERFIL COLUMNA (cada columna suma 100%)
# =========================================================
df_col <- as.data.frame(perfil_columna)
names(df_col) <- c("Fila", "Columna", "Porcentaje")
ggplot(df_col, aes(x = Columna, y = Porcentaje, fill = Fila)) +
geom_col(position = "dodge") +
geom_text(aes(label = sprintf("%.1f%%", Porcentaje)),
position = position_dodge(width = 0.9),
vjust = -0.3, size = 3) +
labs(title = "Perfil por columna",
subtitle = "Porcentaje dentro de cada columna (suma 100%)",
x = NULL, y = "Porcentaje (%)") +
theme_minimal() +
theme(legend.position = "bottom") +
scale_fill_brewer(palette = "Set1")
